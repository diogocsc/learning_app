## Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string

## LLM (Ollama Cloud)
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

## Uploads (bytes)
# 250MB default in app; override if needed (e.g., 500MB = 524288000)
MAX_UPLOAD_BYTES=262144000

## Database
# If unset, defaults to ./data/assistant.db
APP_DB_PATH=/app/data/assistant.db

